<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/accent" android:fontFamily="@font/manrope_family" android:includeFontPadding="false" android:textSize="10sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" android:gravity="center" android:text="@string/refresh_symbol" android:contentDescription="@string/refresh_description" android:textSize="22sp" android:textColor="@color/accent" android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:fontFamily="@font/manrope_family" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="17sp" android:autoSizeStepGranularity="1sp" />
    <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/manrope_family" android:includeFontPadding="false" android:textSize="11sp" android:textColor="@color/muted" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/manrope_family" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/ink" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:fontFamily="@font/manrope_family" android:textSize="10sp" android:textColor="@color/muted" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
